/**
 * Writes scripts/tests/e2ee.vectors.mts. Run it only when the wire format changes on purpose:
 *   node scripts/tests/e2ee.gen-vectors.mts
 * (the file name is not `*.test.mts`, so run-all.mjs skips it).
 */
import { writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import {
  encryptMessage,
  generateIdentity,
  generateRecoverySecret,
  generateRoomKey,
  makeBackup,
  toB64u,
  wrapRoomKey,
  type MessageContext,
} from "../../src/lib/e2ee/crypto.ts";

const id = await generateIdentity();
const roomKey = generateRoomKey();
const context: MessageContext = { scope: "channel", targetId: "ch_vector", keyId: "key_vector", authorId: "user_vector" };
const text = "vector ✓";
const recovery = generateRecoverySecret();

const vectors = {
  publicKey: id.publicKey,
  privateKey: id.privateKey,
  fingerprint: id.fingerprint,
  roomKey: toB64u(roomKey),
  wrapped: await wrapRoomKey(roomKey, id.publicKey),
  context,
  text,
  envelope: await encryptMessage(roomKey, { text }, context),
  recoverySecret: toB64u(recovery),
  backup: await makeBackup(id.privateKey, recovery),
};

const out = join(dirname(fileURLToPath(import.meta.url)), "e2ee.vectors.mts");
writeFileSync(
  out,
  `// Generated by scripts/tests/e2ee.gen-vectors.mts. Do not edit by hand: a change here is a wire-format change.\n` +
    `export const VECTORS = ${JSON.stringify(vectors, null, 2)} as const;\n`,
);
console.log("wrote", out);
