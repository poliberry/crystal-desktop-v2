# Read by static hosts that support a _headers file (Cloudflare Pages / Workers assets).
# The pages that ask someone to agree to something must not be framed by another site: a hidden
# frame with the real "Add" button under a decoy is how a consent screen gets clicked for you.
/oauth/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
/invite/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
