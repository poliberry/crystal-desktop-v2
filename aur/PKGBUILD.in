# Maintainer: Crystal <https://github.com/poliberry/crystal-desktop-v2>
#
# Generated by scripts/make-pkgbuild.mjs from aur/PKGBUILD.in in the release workflow. Edit the template, not this file:
# the next release overwrites it.
#
# It repackages the .deb that the release publishes. Nothing is compiled here.
pkgname=@PKGNAME@
pkgver=@VERSION@
pkgrel=1
pkgdesc='@DESCRIPTION@'
arch=('x86_64')
url='https://github.com/poliberry/crystal-desktop-v2'
license=('custom')
depends=('gtk3' 'nss' 'alsa-lib' 'libnotify' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
optdepends=('libpulse: share system audio while screen sharing'
            'pipewire-pulse: share system audio while screen sharing')
# Electron's binaries are already stripped, and stripping them again breaks them.
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.deb::${url}/releases/download/@TAGPREFIX@${pkgver}/@FILENAME@-${pkgver}.deb")
noextract=("${pkgname}-${pkgver}.deb")
sha256sums=('@SHA256@')

package() {
  # A .deb is an ar archive whose data.tar.* member holds the files to install.
  bsdtar -xOf "${srcdir}/${pkgname}-${pkgver}.deb" 'data.tar*' | bsdtar -xf - -C "${pkgdir}"

  # The .deb names its own launcher. Read it from the desktop entry rather than guess, and link it under a name that
  # can't collide with anything else in /usr/bin (Arch's `crystal` package, the language, owns /usr/bin/crystal).
  local desktop exec
  desktop="$(find "${pkgdir}/usr/share/applications" -name '*.desktop' | head -n 1)"
  [ -n "${desktop}" ] || { echo 'The .deb has no desktop entry to read the launcher from.' >&2; return 1; }
  exec="$(sed -n 's/^Exec=//p' "${desktop}" | head -n 1)"
  case "${exec}" in
    \"*) exec="${exec#\"}"; exec="${exec%%\"*}" ;;
    *) exec="${exec%% *}" ;;
  esac
  [ -x "${pkgdir}${exec}" ] || { echo "The launcher ${exec} is not in the package." >&2; return 1; }

  install -dm755 "${pkgdir}/usr/bin"
  ln -sf "${exec}" "${pkgdir}/usr/bin/@BINARY@"

  # Tells the app that pacman owns these files: it can't replace them itself (they belong to root), so it leaves updating
  # to the package manager instead of offering an update it can't install (electron/updater.ts reads this).
  printf 'aur\n' > "${pkgdir}$(dirname "${exec}")/resources/installed-by"

  # Chromium's sandbox helper has to be setuid root for the sandbox to work without user namespaces.
  find "${pkgdir}/opt" -name chrome-sandbox -exec chmod 4755 {} +
}
