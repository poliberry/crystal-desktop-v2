{
  "name": "crystal-desktop",
  "version": "0.1.37",
  "private": true,
  "description": "Simple voice & video chat desktop app powered by LiveKit, Next.js and shadcn/ui",
  "author": "Crystal",
  "homepage": "https://livekit.io",
  "desktopName": "crystal-desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first -n next,crystal,studio,convex -c blue,green,magenta,gray \"bun run dev:next\" \"bun run dev:electron\" \"bun run dev:studio:wait\" \"bun run dev:convex\"",
    "dev:next": "bun scripts/prepare-studio-assets.mjs && next dev -p 3000",
    "dev:convex": "convex dev",
    "dev:electron": "bun run build:electron && wait-on http-get://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 bun scripts/run-electron.mjs .",
    "build": "bun run build:next && bun run build:electron",
    "build:next": "bun scripts/prepare-studio-assets.mjs && next build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p installer-ui/tsconfig.json && bun scripts/build-installer.mjs",
    "build:native": "bash native/build.sh",
    "dev:studio": "bun scripts/dev-studio.mjs",
    "dev:installer": "bun run build:electron && cross-env CRYSTAL_CHANNEL=${CRYSTAL_CHANNEL:-stable} bun scripts/run-electron.mjs dist-electron/installer/main.js",
    "dist:installer": "bun run build:electron && bun scripts/stage-installer.mjs && cross-env CRYSTAL_APP=installer electron-builder -m --config scripts/electron-builder-config.cjs",
    "dev:studio:wait": "bun scripts/dev-studio.mjs --wait",
    "start": "bun scripts/run-electron.mjs .",
    "token": "bun scripts/token.mjs",
    "guides": "bun scripts/build-guides.mjs",
    "reference": "bun scripts/build-reference.mjs",
    "deploy:web": "bun scripts/deploy-web.mjs",
    "deploy:api": "cd workers/api && wrangler deploy",
    "icons": "bun scripts/make-icons.mjs",
    "test:studio": "bun scripts/make-icons.mjs --check && bun scripts/build-guides.mjs --check && bun scripts/build-reference.mjs --check && bun scripts/tests/run-all.mjs",
    "postinstall": "bun scripts/prepare-studio-assets.mjs",
    "dist": "bun run build:native && bun run build && bun scripts/stage-app.mjs && electron-builder -m --config scripts/electron-builder-config.cjs",
    "dist:studio": "bun run build && bun scripts/stage-app.mjs && cross-env CRYSTAL_APP=studio electron-builder -m --config scripts/electron-builder-config.cjs"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/react": "^6.14.5",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@livekit/krisp-noise-filter": "^0.4.4",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.1.1",
    "frimousse": "^0.3.0",
    "ioredis": "^6.0.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.30.0",
    "moment": "^2.30.1",
    "monaco-editor": "0.52.2",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "paper": "^0.12.18",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "serve-handler": "^6.1.7",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/serve-handler": "^6.1.4",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.2",
    "wait-on": "^9.1.0"
  }
}
