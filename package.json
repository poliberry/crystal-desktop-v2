{
  "name": "crystal-desktop",
  "version": "0.1.27",
  "private": true,
  "description": "Simple voice & video chat desktop app powered by LiveKit, Next.js and shadcn/ui",
  "author": "Crystal",
  "homepage": "https://livekit.io",
  "desktopName": "crystal-desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"bun run dev:next\" \"bun run dev:electron\" \"bun run dev:convex\"",
    "dev:next": "next dev -p 3000",
    "dev:convex": "convex dev",
    "dev:electron": "bun run build:electron && wait-on http-get://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 bun scripts/run-electron.mjs .",
    "build": "bun run build:next && bun run build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:native": "bash native/build.sh",
    "start": "bun scripts/run-electron.mjs .",
    "token": "bun scripts/token.mjs",
    "dist": "bun run build:native && bun run build && electron-builder -m --config scripts/electron-builder-config.cjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/react": "^6.14.5",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@livekit/krisp-noise-filter": "^0.4.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.1",
    "frimousse": "^0.3.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.30.0",
    "moment": "^2.30.1",
    "next": "^16.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "serve-handler": "^6.1.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/serve-handler": "^6.1.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
